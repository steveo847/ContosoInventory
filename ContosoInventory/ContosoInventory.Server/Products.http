@baseUrl = http://localhost:5240
@productId = 1
@categoryId = 1

### Sign in as the seeded Admin user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "mateo@contoso.com",
  "password": "Password123!"
}

### Get all products
GET {{baseUrl}}/api/products

### Get products in a category
GET {{baseUrl}}/api/products?categoryId={{categoryId}}

### Get a product by ID
GET {{baseUrl}}/api/products/{{productId}}

### Get a product that does not exist (expect 404)
GET {{baseUrl}}/api/products/999999

### Create a product (requires an Admin session)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "sku": "MOUSE-001",
  "description": "Wireless optical mouse",
  "price": 29.99,
  "stockQuantity": 25,
  "categoryId": 1
}

### Update a product (requires an Admin session)
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "sku": "MOUSE-001",
  "description": "Wireless optical mouse with USB receiver",
  "price": 31.99,
  "categoryId": 1
}

### Restock a product (requires an Admin session)
POST {{baseUrl}}/api/products/{{productId}}/restock
Content-Type: application/json

{
  "quantity": 10
}

### Delete a product (requires an Admin session)
DELETE {{baseUrl}}/api/products/{{productId}}
